# ==============================================================================
# Email Automation & Reminder System - Configuration Template
# Instructions: Copy this file to '.env' and fill in your actual credentials.
# WARNING: NEVER commit your actual '.env' file or passwords to GitHub!
# ==============================================================================

# Simulation & Safety Switch
# When set to True, the system operates in DRY RUN mode (no real emails sent).
# Simulated emails are rendered, validated, logged, and saved to outputs/simulated_emails/.
DRY_RUN=True

# SMTP Server Configuration
# Gmail: smtp.gmail.com | Port: 587 (TLS) or 465 (SSL)
# Outlook: smtp-mail.outlook.com | Port: 587
# Mailtrap (Testing): sandbox.smtp.mailtrap.io | Port: 2525
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
USE_TLS=True

# Sender Credentials
# For Gmail: Use a 16-character 'Google App Password', NOT your personal Gmail account password.
# Guide: Google Account -> Security -> 2-Step Verification -> App Passwords
SENDER_NAME=Operations Team
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_16_digit_app_password_here

# Scheduler Configuration
# Interval in seconds between check cycles (e.g., 60 seconds)
CHECK_INTERVAL_SECONDS=30

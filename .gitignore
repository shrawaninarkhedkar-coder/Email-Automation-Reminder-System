# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Virtual Environments
venv/
env/
ENV/
.venv/

# Environment Variables & Sensitive Credentials (CRITICAL: DO NOT COMMIT REAL CREDS)
.env
.env.local
.env.*.local
*.pem
*.key

# Application Data & Temporary Run Outputs
# Keep sample files, but ignore live generated outputs & logs
logs/*.log
outputs/simulated_emails/*.html
!outputs/delivery_report_sample.csv

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
